  <string name="BotRelayApiHash">API_HASH</string>
  <string name="BotRelayApiHint">数字形式的 API ID</string>
  <string name="BotRelayApiHashHint">32 位十六进制字符串</string>
  <string name="BotRelayApiInfo">用于在 my.telegram.org 创建的应用凭据。自建「受限内容保存」服务（Pyrogram / Telethon 的 user session 方案）或部署本项目的 Cloudflare 中转时使用；仅在本机使用机器人中转时可以不填。</string>

